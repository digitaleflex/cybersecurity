{
  "name": "hashcode-cyber-library",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "e2e": "playwright test",
    "lighthouse": "node e2e/lighthouse.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run check && npm run lint && npm run format:check && npm run typecheck && npm run validate:catalog && npm test",
    "health": "node scripts/check-links.mjs --health --no-fail"
  },
  "license": "MIT",
  "homepage": "https://cybersecurity.eflex.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitaleflex/cybersecurity.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
