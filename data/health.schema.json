{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersecurity.eflex.app/data/health.schema.json",
  "title": "HashCode Cyber Library — santé des liens",
  "description": "Résultat du dernier contrôle des liens (scripts/check-links.mjs --health). Fichier généré : ne pas le modifier à la main.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "checked",
    "results"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date du contrôle."
    },
    "source": {
      "type": "string"
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "health"
        ],
        "properties": {
          "health": {
            "enum": [
              "ok",
              "redirect",
              "blocked",
              "unreachable",
              "broken"
            ],
            "description": "ok : répond ; redirect : l'adresse a changé de site ; blocked : le site refuse les robots (403/429) ; unreachable : erreur serveur ou réseau passagère ; broken : introuvable (404/410, domaine inexistant)."
          },
          "detail": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
