{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersecurity.eflex.app/data/resources.schema.json",
  "title": "HashCode Cyber Library — fiche de ressource",
  "description": "Schéma d'une entrée du tableau `resources` de data/resources.json. Les règles de référence sont dans js/resource-schema.js ; un test garantit que les deux restent équivalents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "url",
    "domain",
    "category",
    "type",
    "level",
    "access",
    "language",
    "tags",
    "source",
    "verified",
    "status",
    "featured"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant stable : minuscules, chiffres et tirets."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "Adresse officielle de la ressource."
    },
    "domain": {
      "enum": [
        "fundamentals",
        "osint",
        "red-team",
        "blue-team",
        "reverse-engineering",
        "malware-analysis",
        "cloud-security",
        "application-security",
        "ctf-labs",
        "courses-books",
        "communities",
        "research-reports"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "tool",
        "course",
        "lab",
        "documentation",
        "repository",
        "framework",
        "platform",
        "community",
        "report",
        "library",
        "directory",
        "database"
      ]
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "professional"
      ]
    },
    "access": {
      "enum": [
        "free",
        "freemium",
        "paid"
      ]
    },
    "language": {
      "type": "array",
      "items": {
        "enum": [
          "fr",
          "en",
          "multi"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "description": "Date de vérification par un mainteneur (YYYY-MM-DD) ; null tant que la fiche n'est pas vérifiée.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "status": {
      "enum": [
        "verified",
        "needs-review",
        "archived",
        "removed"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date d'ajout au catalogue (jamais une date de vérification)."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "Licence ou modèle d'accès si connu (texte libre ou identifiant SPDX). Facultatif."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs-review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verified": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verified": {
            "type": "string"
          }
        }
      }
    }
  ]
}
